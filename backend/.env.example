# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=5000

# Replica set recommended (enables MongoDB transactions). `npm run db:dev` starts one locally:
#   MONGODB_URI=mongodb://127.0.0.1:27018/sundhamata?replicaSet=rs0
# A standalone server also works in development (compensating rollbacks instead of transactions);
# production refuses to start without transaction support.
MONGODB_URI=mongodb://127.0.0.1:27017/sundhamata

# At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=
JWT_EXPIRES_IN=7d
ADMIN_JWT_EXPIRES_IN=12h

# Allowed browser origins (comma-separated lists allowed). Both apps are currently served by one Vite app.
CUSTOMER_FRONTEND_URL=http://localhost:5173
ADMIN_FRONTEND_URL=http://localhost:5173

# Initial loyalty rate used only when store settings are first created; afterwards edit it in Admin > Settings.
LOYALTY_POINTS_PER_100=1

# OTP policy
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_SENDS_PER_HOUR=5
# Fixed OTP accepted outside production only (ignored when NODE_ENV=production).
DEV_OTP_CODE=123456
# SMS delivery provider. Only "console" (logs the code, development only) exists today.
SMS_PROVIDER=console

BCRYPT_ROUNDS=12
RATE_LIMIT_ENABLED=true
# Number of reverse proxies in front of the API (0 when exposed directly).
TRUST_PROXY=0
# LOG_LEVEL=info
